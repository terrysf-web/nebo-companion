# ── Claude (brief summarisation) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Change only if you want a different model.
ANTHROPIC_MODEL=claude-opus-5

# ── Weather (OpenWeatherMap, free key) ──────────────────────────────
# Leave empty to build the brief without a weather section.
OWM_API_KEY=
WEATHER_LAT=37.5665
WEATHER_LON=126.9780
WEATHER_PLACE=Seoul

# ── Nextcloud (brief HTML + planner / brief PDFs) ───────────────────
# Use the NAS's real IP or hostname — not localhost.
NC_URL=http://192.168.0.10:8080
NC_USER=terry
NC_PASS=
# Folder created inside Nextcloud
NC_DIR=Morning
# Set to 0 to skip uploading
NC_UPLOAD=1

# ── Google OAuth client (only needed to mint tokens with auth_setup) ─
# If tokens/credentials.json exists these two can stay empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Behaviour ───────────────────────────────────────────────────────
TZ=Asia/Seoul
# Output language for the brief and the PDFs: en or ko
LANG_OUT=en
# Daily brief time (24h)
BRIEF_HOUR=6
BRIEF_MINUTE=0
# Planner generation time, on the 1st of each month
PLANNER_HOUR=5
PLANNER_MINUTE=30
# How many days ahead the brief looks
LOOKAHEAD_DAYS=3
# Max unread mails per account in the brief
MAIL_LIMIT=12
# Web port (keep in sync with ports: in docker-compose.yml)
PORT=9000

# ── Planner PDF (for handwriting on the tablet) ─────────────────────
# tablet = TCL NXTPAPER aspect (5:3) landscape; also a4 / a5 (landscape)
PLANNER_PAGE=tablet
# Hour range on the day pages
PLANNER_START_HOUR=6
PLANNER_END_HOUR=22
# Week starts on: mon or sun
PLANNER_WEEK_START=mon
# Months per file for the automatic monthly build (1 = next month only).
# For a one-off longer planner use main.py --months N or --through YYYY-MM.
PLANNER_MONTHS=1
# Blank meeting-note pages in each planner file (not per month)
PLANNER_MEETING_PAGES=12
# Habit tracker rows on the weekly page (comma separated)
PLANNER_HABITS=Move,Read,Deep work,Sleep 7h

# ── Nebo workflow ───────────────────────────────────────────────────
# The brief is always written as .txt to paste into a Nebo page.
# Also produce the write-on-it PDF version of the brief? (1/0)
BRIEF_PDF=1
# Build the planner PDF automatically on the 1st? (1/0)
# The CLI can still build one on demand with --planner-only.
PLANNER_ENABLED=0
